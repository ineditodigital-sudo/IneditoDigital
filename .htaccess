# ============================================================
# Inédito Digital — .htaccess de producción (/public_html/)
#
# IMPORTANTE: los subdominios de cPanel cuelgan de esta misma carpeta y
# HEREDAN las cabeceras de este archivo. Por eso todo va acotado por Host
# con expr=, para no tocar los proyectos de otros clientes en
# *.inedito.digital. Ver docs/REGLAS_SERVIDOR_INEDITO.md.
#
# Se usa expr= y NO la variable E= de mod_rewrite: en la redirección
# interna hacia render.php, Apache renombra esas variables a REDIRECT_*
# y las cabeceras dejarían de aplicarse.
# ============================================================

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Bloquear archivos sensibles, solo en el sitio principal
  RewriteCond %{HTTP_HOST} ^(www\.)?inedito\.digital$ [NC]
  RewriteRule \.(sql|bak|log|env|zip|tar|gz|tgz)$ - [F,L]

  # Canónica: apex -> www (coincidencia EXACTA, nunca subdominios)
  RewriteCond %{HTTP_HOST} ^inedito\.digital$ [NC]
  RewriteRule ^(.*)$ https://www.inedito.digital/$1 [R=301,L]

  # Redirección de PDF específica
  Redirect 301 /wp-content/uploads/PDFS/PATRON-FLEX.pdf https://imagenes.inedito.digital/FLEX/PATRON-FLEX.pdf

  # Recursos generados dinámicamente
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]
  # La tarjeta de contacto de un integrante: /armando-trejo.vcf
  RewriteRule ^([a-z0-9-]+)\.vcf$ /tarjeta.php?m=$1 [L,QSA]
  RewriteRule ^llms-full\.txt$ /llms-full.php [L]

  # ---- 301 de las URLs del sitio WordPress anterior (auditoría IDX-01) ----
  # Google todavía las tiene indexadas y hoy mueren en 404: cada una se manda
  # a su equivalente actual para no tirar la autoridad acumulada.
  RewriteRule ^diseno-y-desarrollo-web/?$ /servicios/diseno-y-desarrollo-web [R=301,L]
  RewriteRule ^paginas-web/?$ /servicios/diseno-y-desarrollo-web [R=301,L]
  RewriteRule ^posicionamiento-organico/?$ /servicios/posicionamiento-organico [R=301,L]
  RewriteRule ^tarjetas-digitales/?$ /servicios/tarjetas-de-presentacion-digital [R=301,L]
  RewriteRule ^(casos-de-exito/)?ofitodo-posicionamiento-en-ventas-digitales-gracias-a-inedito-digital/?$ /portafolio/ofitodo [R=301,L]
  RewriteRule ^casos-de-exito(/.*)?$ /portafolio [R=301,L]
  RewriteRule ^alaman/?$ /portafolio [R=301,L]
  RewriteRule ^apps/?$ /servicios [R=301,L]
  RewriteRule ^espacios-publicitarios(-[a-z0-9-]*)?/?$ /servicios [R=301,L]
  RewriteRule ^creacion-de-logo/?$ /servicios/creacion-de-logo [R=301,L]

  # /glosario existio unas horas el 26/08 y llego a estar en el sitemap.
  # Se retiro por falta de demanda medida; la URL no puede quedar en 404.
  RewriteRule ^glosario/?$ /servicios [R=301,L]

  # ---- 301 medidas con datos de Google (21/08/2026, IDX-08) ----
  # Salen de pedirle a Search Console las URLs que aun muestra en resultados y
  # comprobar el codigo real de cada una: 44 daban 404, con 4.696 impresiones y
  # 41 clics cayendo en una pagina de error. Cada regla apunta a una pagina que
  # existe de verdad en el sitemap; ninguna es un destino inventado.

  # Servicios del sitio anterior que hoy tienen ficha propia
  RewriteRule ^branding/?$              /servicios/branding [R=301,L]
  RewriteRule ^servicios-qr/?$          /servicios/servicios-qr [R=301,L]
  RewriteRule ^email-mkt/?$             /servicios/email-marketing [R=301,L]
  RewriteRule ^google-ads/?$            /servicios/google-ads [R=301,L]
  RewriteRule ^chat-bots/?$             /servicios/chatbots-y-agentes [R=301,L]
  RewriteRule ^seo-sem/?$               /servicios/posicionamiento-organico [R=301,L]
  RewriteRule ^(technology/)?(personalizacion-con-)?inteligencia-artificial/?$ /servicios-ia [R=301,L]

  # Servicios sin equivalente exacto: al listado, que es lo mas cercano honesto.
  # /produccion-audiovisual es el 404 con mas clics de todo el sitio (813
  # impresiones, 15 clics): merece pagina propia, no solo una redireccion.
  RewriteRule ^produccion-audiovisual/?$ /servicios [R=301,L]
  RewriteRule ^marketing-digital/?$      /servicios [R=301,L]
  RewriteRule ^redes-sociales/?$         /servicios [R=301,L]

  # Fichas de cliente del sitio anterior que hoy son casos del portafolio
  RewriteRule ^evince/?$                /portafolio/evince-kubera [R=301,L]
  RewriteRule ^1828-brasa-y-carbon/?$   /portafolio/1828-brasa-carbon [R=301,L]
  RewriteRule ^ofitodo/?$               /portafolio/ofitodo [R=301,L]
  RewriteRule ^(maindsoft|coraca|alver|hanshake|rentacargo|fnsm|riolimpio|ibarra-duran-asociados|prueba-club-campestre)/?$ /portafolio [R=301,L]
  RewriteRule ^la-mejor-opcion-en-marketing-digital-en-aguascalientes/?$ /portafolio [R=301,L]
  RewriteRule ^(feria-de-san-marcos-un-caso-de-exito-rotundo-gracias-al-seo|alver-un-caso-de-exito-en-ventas-de-equipo-de-seguridad-industrial-gracias-a-google-ads)/?$ /portafolio [R=301,L]
  RewriteRule ^category/casos-de-exito/?$ /portafolio [R=301,L]

  # Blog anterior: vivia bajo /technology/ y tambien en la raiz. Ninguno de esos
  # articulos se reescribio, asi que van al listado del blog actual.
  RewriteRule ^technology(/.*)?$ /blog [R=301,L]
  RewriteRule ^(realidad-virtual-adentrate-en-el-futuro-del-marketing-digital|marketing-de-voz-escucha-las-nuevas-tendencias-del-2024|sostenibilidad-en-marketing-la-clave-para-conquistar-en-la-era-digital|cgu-convierte-a-tus-clientes-en-las-estrellas|microinfluencers-la-nueva-ola-del-marketing-digital-que-conquista-a-las-marcas|5-senales-de-que-tu-negocio-nececita-ayusa-de-expertos-en-marketing-digital)/?$ /blog [R=301,L]

  # Restos del gestor anterior: version en ingles que ya no existe y el menu.
  RewriteRule ^en(/home)?/?$   / [R=301,L]
  RewriteRule ^megamenu(/.*)?$ / [R=301,L]

  RewriteRule ^llms\.txt$    /llms.php    [L]
  RewriteRule ^$             /render.php  [L]

  # Panel de administración migrado a PHP
  RewriteRule ^admin(/.*)?$ /panel/ [R=302,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /render.php [L]
</IfModule>

<IfModule mod_headers.c>
  # --- Cabeceras de seguridad (solo el sitio principal) ---
  Header always set X-Content-Type-Options "nosniff"                              "expr=%{HTTP_HOST} =~ /^(www\.)?inedito\.digital$/"
  Header always set X-Frame-Options "SAMEORIGIN"                                  "expr=%{HTTP_HOST} =~ /^(www\.)?inedito\.digital$/"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"             "expr=%{HTTP_HOST} =~ /^(www\.)?inedito\.digital$/"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()" "expr=%{HTTP_HOST} =~ /^(www\.)?inedito\.digital$/"
  # HSTS sin includeSubDomains: hay ~60 subdominios que no controlamos desde aquí
  Header always set Strict-Transport-Security "max-age=31536000"                  "expr=%{HTTP_HOST} =~ /^(www\.)?inedito\.digital$/"

  # --- Assets con hash en el nombre: caché de un año ---
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{HTTP_HOST} =~ /^(www\.)?inedito\.digital$/ && %{REQUEST_URI} =~ m#^/assets/#"
  # Los archivos sueltos con nombre fijo (video de fondo, iconos, videos del
  # 404) no llevan huella en el nombre, asi que se cachean un mes en vez de un
  # año: si alguno se reemplaza, se renueva solo en un plazo razonable.
  Header set Cache-Control "public, max-age=2592000" "expr=%{HTTP_HOST} =~ /^(www\.)?inedito\.digital$/ && %{REQUEST_URI} =~ m#\.(mp4|webm|ico|png|webp|jpg|svg|woff2)$#"

  # --- index.html nunca se cachea: render.php lee de ahí los hashes ---
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors Off
   php_value max_execution_time 30
   php_value max_input_time 60
   php_value max_input_vars 2004
   php_value memory_limit 1000M
   php_value post_max_size 1000M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php83"
   php_value upload_max_filesize 1000M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_value max_execution_time 30
   php_value max_input_time 60
   php_value max_input_vars 2004
   php_value memory_limit 1000M
   php_value post_max_size 1000M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php83"
   php_value upload_max_filesize 1000M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
