# ============================================================
# Inédito Digital — .htaccess de producción (/public_html/)
#
# IMPORTANTE: los subdominios de cPanel cuelgan de esta misma carpeta y
# HEREDAN las cabeceras de este archivo. Por eso TODO lo que se añade aquí
# va acotado por host (env INEDITO_MAIN) para no tocar los proyectos de
# otros clientes en *.inedito.digital. Ver REGLAS_SERVIDOR_INEDITO.md.
# ============================================================

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Marca: la petición es del sitio principal (no de un subdominio ajeno)
  RewriteCond %{HTTP_HOST} ^(www\.)?inedito\.digital$ [NC]
  RewriteRule ^ - [E=INEDITO_MAIN:1]

  # Marca: asset con hash de Vite, solo en el sitio principal
  RewriteCond %{HTTP_HOST} ^(www\.)?inedito\.digital$ [NC]
  RewriteRule ^assets/ - [E=INEDITO_ASSET:1]

  # Bloquear archivos sensibles, solo en el sitio principal
  RewriteCond %{HTTP_HOST} ^(www\.)?inedito\.digital$ [NC]
  RewriteRule \.(sql|bak|log|env|zip|tar|gz|tgz)$ - [F,L]

  # --- Canónica: apex -> www (coincidencia EXACTA, nunca subdominios) ---
  RewriteCond %{HTTP_HOST} ^inedito\.digital$ [NC]
  RewriteRule ^(.*)$ https://www.inedito.digital/$1 [R=301,L]

  # Redirección de PDF específica
  Redirect 301 /wp-content/uploads/PDFS/PATRON-FLEX.pdf https://imagenes.inedito.digital/FLEX/PATRON-FLEX.pdf

  # Recursos generados dinámicamente
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]
  RewriteRule ^llms\.txt$    /llms.php    [L]
  RewriteRule ^$             /render.php  [L]

  # Panel de administración migrado a PHP
  RewriteRule ^admin(/.*)?$ /panel/ [R=302,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /render.php [L]
</IfModule>

<IfModule mod_headers.c>
  # --- Cabeceras de seguridad (solo sitio principal) ---
  Header always set X-Content-Type-Options "nosniff"                                    env=INEDITO_MAIN
  Header always set X-Frame-Options "SAMEORIGIN"                                        env=INEDITO_MAIN
  Header always set Referrer-Policy "strict-origin-when-cross-origin"                   env=INEDITO_MAIN
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"       env=INEDITO_MAIN
  # HSTS sin includeSubDomains: hay ~60 subdominios que no controlamos desde aquí
  Header always set Strict-Transport-Security "max-age=31536000"                        env=INEDITO_MAIN

  # --- Caché: assets con hash, inmutables 1 año ---
  Header set Cache-Control "public, max-age=31536000, immutable" env=INEDITO_ASSET

  # --- index.html nunca se cachea: render.php lee de ahí los hashes ---
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors Off
   php_value max_execution_time 30
   php_value max_input_time 60
   php_value max_input_vars 2004
   php_value memory_limit 1000M
   php_value post_max_size 1000M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php83"
   php_value upload_max_filesize 1000M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_value max_execution_time 30
   php_value max_input_time 60
   php_value max_input_vars 2004
   php_value memory_limit 1000M
   php_value post_max_size 1000M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php83"
   php_value upload_max_filesize 1000M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
